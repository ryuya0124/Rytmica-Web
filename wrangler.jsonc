{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rytmica-web",
  "main": "server/index.jsx",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
